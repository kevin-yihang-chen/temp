{
  "schema": "predictability_audit_protocol_v1",
  "frozen_at": "2026-09-03T17:20:00+08:00",
  "research_question": "Can pre-action VLM state stably predict the utility of invoking one fixed visual tool?",
  "task": {
    "actions": [
      "ANSWER_NOW",
      "USE_VISUAL_TOOL"
    ],
    "where_selection_learned": false,
    "labels": [
      "Y0",
      "Ytool",
      "direct_gain",
      "rescue",
      "harm"
    ],
    "rescue_definition": "Ytool > Y0",
    "harm_definition": "Ytool < Y0",
    "prediction_is_cost_independent": true
  },
  "fixed_visual_tool": {
    "policy": "entropy_search",
    "candidate_bank": "four_frozen_ug_grid_crops",
    "candidate_count": 4,
    "execution": "evaluate_all_candidates_then_select_minimum_post_action_entropy",
    "tie_break": "ascending_action_id",
    "charged_calls": 4,
    "lambda_cost": 0.05,
    "lambda_applied_only_at_policy_time": true
  },
  "benchmarks": [
    "chartqa",
    "docvqa",
    "hrbench"
  ],
  "split_contract": {
    "roles": [
      "train",
      "validation",
      "test"
    ],
    "grouping": "source_id_and_decoded_rgb_sha256",
    "pairwise_role_overlap_must_be_zero": true,
    "validation_use": "model_variant_threshold_and_calibration_only",
    "test_use": "single_frozen_evaluation_only",
    "historically_opened_rows_allowed_for_final_test": false
  },
  "predictor_ladder": {
    "l0_uncertainty": [
      "entropy_before",
      "max_probability",
      "top1_top2_margin"
    ],
    "l1_shallow": {
      "inputs": "l0_plus_shallow_question_and_state_features",
      "models": [
        "logistic",
        "fixed_small_mlp"
      ]
    },
    "l2_semantic": {
      "inputs": "l0_plus_question_embedding_plus_global_visual_embedding_plus_elementwise_interaction",
      "models": [
        "fixed_small_mlp"
      ]
    },
    "l3_frozen_qwen": {
      "inputs": "l0_plus_pooled_language_plus_pooled_visual_plus_fused_multimodal_states",
      "models": [
        "linear",
        "fixed_two_layer_mlp"
      ]
    }
  },
  "target_families": {
    "direct_gain": "regress_Ytool_minus_Y0",
    "rescue_harm": "separate_binary_rescue_and_harm_heads",
    "factorized": "P(error)*P(rescue_given_error)-P(correct)*P(harm_given_correct)",
    "factorized_error_definition": "Y0 < 1.0",
    "factorized_correct_definition": "Y0 == 1.0"
  },
  "post_action_probe": {
    "count": 1,
    "target": "direct_gain",
    "model": "fixed_two_layer_mlp",
    "role": "diagnostic_only_never_deployable"
  },
  "training": {
    "seeds": [
      17,
      29,
      47
    ],
    "maximum_seeds": 3,
    "source_weighting": "inverse_question_count_per_source_normalized_to_mean_one",
    "probability_calibration": "validation_logistic_calibration_of_frozen_raw_score_for_positive_net_rescue_and_harm",
    "fixed_model_hyperparameters": {
      "linear_regularization": 1.0,
      "l1_small_mlp_hidden": [
        32
      ],
      "l2_small_mlp_hidden": [
        64
      ],
      "l3_two_layer_mlp_hidden": [
        128,
        32
      ],
      "mlp_activation": "relu",
      "mlp_alpha": 0.0001,
      "maximum_iterations": 500
    },
    "threshold_selection": "maximize_validation_utility_then_fewer_calls_then_ascending_threshold",
    "no_architecture_loss_feature_or_seed_search_after_freeze": true
  },
  "hard_matrix": {
    "benchmarks": 3,
    "predictor_levels": 4,
    "target_families": 3,
    "required_cells": 36
  },
  "metrics": {
    "prediction": [
      "auroc",
      "auprc",
      "brier",
      "calibration_error",
      "rescue_auprc",
      "harm_auprc"
    ],
    "policy": [
      "accuracy",
      "cost",
      "call_rate",
      "utility",
      "rescue_precision",
      "harm_rate",
      "marginal_gain_per_call"
    ],
    "curves": "accuracy_cost_call_rate",
    "curve_call_rates": [
      0.0,
      0.005,
      0.01,
      0.02,
      0.05,
      0.1,
      0.2,
      0.5,
      1.0
    ],
    "primary_endpoint": "incremental_source_balanced_utility",
    "uncertainty": {
      "method": "paired_source_bootstrap",
      "confidence_level": 0.95,
      "resamples": 20000,
      "seed": 20260903
    }
  },
  "strong_baselines": [
    "answer_now",
    "entropy_gate_fixed_visual_tool",
    "random_gate_fixed_visual_tool",
    "fixed_crop_with_matched_gate",
    "uniform_random_crop_expectation_with_matched_gate",
    "exhaustive_ug_entropy_search_charged_four_calls"
  ],
  "verdict_rules": {
    "priority": [
      "STOP",
      "GO",
      "REPRESENTATION",
      "PIVOT"
    ],
    "minimum_benchmarks": 2,
    "small_oracle_utility": 0.005,
    "GO": "best deployable beats strongest baseline with paired 95% lower CI above zero on at least two benchmarks and passes registered rescue_harm_Pareto checks",
    "PIVOT": "oracle utility exceeds small threshold and post-action probe utility lower CI is positive on at least two benchmarks while every deployable predictor fails",
    "REPRESENTATION": "L3 in-domain improvement lower CI is positive on at least two benchmarks but image-disjoint or cross-domain improvement upper CI is non-positive on at least two",
    "STOP": "oracle utility is at most the small threshold on at least two benchmarks",
    "inconclusive": "raise_and_do_not_emit_final_verdict"
  }
}
